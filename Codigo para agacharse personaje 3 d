extends CharacterBody3D

@export var velocidad_salto: float = 6.0
@export var gravedad: float = 9.8
@export var velocidad_agachado: float = 2.0

var agachado: bool = false

func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity.y -= gravedad * delta

	if Input.is_action_just_pressed("saltar"):
		saltar()

	if Input.is_action_just_pressed("agacharse"):
		agachado = not agachado

	move_and_slide()

func saltar() -> void:
	if is_on_floor() and not agachado:
		velocity.y = velocidad_salto

func _on_boton_saltar_pressed() -> void:
	saltar()

func _on_boton_agacharse_pressed() -> void:
	agachado = not agachado

func _input(event: InputEvent) -> void:
	if event.is_action_pressed("agacharse"):
		agachado = true
	elif event.is_action_released("agacharse"):
		agachado = false
