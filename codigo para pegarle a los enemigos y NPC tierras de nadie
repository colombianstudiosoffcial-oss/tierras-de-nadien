extends CharacterBody3D

@export var vida_maxima: int = 100
@export var fuerza_retroceso: float = 5.0

var vida: int

func _ready() -> void:
    vida = vida_maxima

func recibir_danio(cantidad: int, origen: Vector3) -> void:
    vida -= cantidad

    # Hacer retroceder al personaje
    var direccion = global_position - origen
    direccion.y = 0

    if direccion.length_squared() > 0.001:
        direccion = direccion.normalized()
        velocity.x = direccion.x * fuerza_retroceso
        velocity.z = direccion.z * fuerza_retroceso

    print("El personaje recibió daño. Vida restante: ", vida)

    if vida <= 0:
        morir()

func morir() -> void:
    print("El personaje ha sido derrotado.")
    queue_free()
